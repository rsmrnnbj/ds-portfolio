t","value":"Laboratory Activity 6","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vY4NPZSZ0V"}],"identifier":"laboratory-activity-6","label":"Laboratory Activity 6","html_id":"laboratory-activity-6","implicit":true,"key":"oZcRHuxmWg"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Instruction: Convert the given CNN architecture diagram into a PyTorch CNN Architecture.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SZuDV7mdK5"}],"key":"MyhaYDJSpE"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The diagram contains four convolutional layers, two max-pooling layers, a dropout layer, three fully connected layers, ReLU activations, and a final SoftMax output.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"EWuqJHJjjz"}],"key":"TxE3KZnhOa"},{"type":"image","url":"attachment:task6_architecture.png","alt":"CNN architecture diagram","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"uhADhgd4ri"}],"key":"Ip77ZAJQ5m"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"class CNN(nn.Module):\n    def __init__(self):\n        super().__init__()\n\n        # Convolutional layers\n        self.conv1 = nn.Conv2d(1, 32, kernel_size=3, stride=1, padding=1)\n        self.pool1 = nn.MaxPool2d(kernel_size=2, stride=2, padding=1)\n\n        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, stride=1, padding=1)\n        self.conv3 = nn.Conv2d(64, 128, kernel_size=3, stride=1, padding=1)\n        self.conv4 = nn.Conv2d(128, 256, kernel_size=3, stride=1, padding=1)\n\n        self.pool2 = nn.MaxPool2d(kernel_size=2, stride=2, padding=0)\n\n        # Dropout\n        self.dropout = nn.Dropout(p=0.2)\n\n        # Fully connected layers\n        self.fcn1 = nn.Linear(256 * 7 * 7, 1000)\n        self.fcn2 = nn.Linear(1000, 500)\n        self.fcn3 = nn.Linear(500, 10)\n\n    def forward(self, x):\n        x = F.relu(self.conv1(x))\n        x = self.pool1(x)\n\n        x = F.relu(self.conv2(x))\n        x = F.relu(self.conv3(x))\n        x = F.relu(self.conv4(x))\n        x = self.pool2(x)\n\n        x = self.dropout(x)\n\n        x = x.view(x.size(0), -1)\n\n        x = F.relu(self.fcn1(x))\n        x = F.relu(self.fcn2(x))\n        x = F.softmax(self.fcn3(x), dim=1)\n\n        return x\n","key":"qg8rBFdDez"},{"type":"outputs","id":"YMaO3P0Uiuq33cnPPckwy","children":[],"key":"fLvZgh7fMP"}],"key":"z9iOoOjrOu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Instantiate the CNN","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XBanfvUmCS"}],"identifier":"instantiate-the-cnn","label":"Instantiate the CNN","html_id":"instantiate-the-cnn","implicit":true,"key":"mU5Vp3uA54"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The class can now be instantiated to create the CNN model.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"o5nsSPJ6f6"}],"key":"IHkWwJyDwT"}],"key":"mFCRBzRBkd"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"model = CNN()\nmodel","key":"HkRDL4lAyP"},{"type":"outputs","id":"RX_UihfFj46UUHzMOOBfd","children":[],"key":"If2EalapDt"}],"key":"kxx5uGuVvv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Check the Output Shape","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m3WH0vEsZl"}],"identifier":"check-the-output-shape","label":"Check the Output Shape","html_id":"check-the-output-shape","implicit":true,"key":"kFR18MUrVj"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Since the MNIST input has one channel and a size of 28 × 28, a sample input can be created with the shape ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iqED1qVlLO"},{"type":"inlineCode","value":"(32, 1, 28, 28)","key":"OExkPxWiFD"},{"type":"text","value":", where 32 represents the batch size. The final layer should produce 10 outputs, one for each digit from 0 to 9.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VeL1kPhtAM"}],"key":"ODzZsdba6M"}],"key":"hILAZ2PeUQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sample_input = torch.randn(32, 1, 28, 28)\n\noutput = model(sample_input)\n\nprint(\"Input shape:\", sample_input.shape)\nprint(\"Output shape:\", output.shape)","key":"KdDp64SfKp"},{"type":"outputs","id":"tzv6k7yMcvesJIIEsqHyG","children":[],"key":"A9cdFhwIUx"}],"key":"VOuKlHp46u"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"heck the Intermediate Shapes","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rvYZhpF6Pf"}],"identifier":"heck-the-intermediate-shapes","label":"heck the Intermediate Shapes","html_id":"heck-the-intermediate-shapes","implicit":true,"key":"lEvdiK8L69"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The intermediate shapes can also be checked to make sure that the architecture follows the given diagram. The first pooling layer changes the spatial size from 28 × 28 to 15 × 15 because it uses padding of 1. The second pooling layer then changes 15 × 15 to 7 × 7.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fFkicIXElS"}],"key":"DxAkPmgU8U"}],"key":"Bri7gq23kT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"x = sample_input\n\nx = F.relu(model.conv1(x))\nprint(\"After Conv1:\", x.shape)\n\nx = model.pool1(x)\nprint(\"After MaxPool1:\", x.shape)\n\nx = F.relu(model.conv2(x))\nprint(\"After Conv2:\", x.shape)\n\nx = F.relu(model.conv3(x))\nprint(\"After Conv3:\", x.shape)\n\nx = F.relu(model.conv4(x))\nprint(\"After Conv4:\", x.shape)\n\nx = model.pool2(x)\nprint(\"After MaxPool2:\", x.shape)\n\nx = model.dropout(x)\nx = x.view(x.size(0), -1)\nprint(\"After Flatten:\", x.shape)","key":"C3WjNZCGG0"},{"type":"outputs","id":"NC4uFn7jxT6vBNyiTEirG","children":[],"key":"n2LVkDnIFI"}],"key":"IZpTp8NWjq"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"The CNN was created based on the architecture shown in the diagram. The input is a grayscale MNIST image with one channel and a size of 28 × 28. The first convolutional layer changes the number of channels from 1 to 32 while keeping the spatial size at 28 × 28 because a kernel size of 3 and padding of 1 are used.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dTWsG0ILGe"}],"key":"ebZGm2uLGN"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The first max-pooling layer reduces the spatial dimensions to 15 × 15. Three more convolutional layers then increase the number of feature channels from 32 to 64, then 128, and finally 256. The second max-pooling layer reduces the feature maps to 7 × 7.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eZ5xtrjp5l"}],"key":"djxnMPcgk9"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"After pooling, dropout with a probability of 0.2 is applied. The feature maps are then flattened into 256 × 7 × 7 = 12,544 values before entering the fully connected layers. The first fully connected layer produces 1,000 values, the second produces 500 values, and the final layer produces 10 outputs. ReLU is used in the hidden layers, while SoftMax is applied to the final output to produce class probabilities for the ten MNIST digits.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"RIVPRMtSyY"}],"key":"J6mHzz7M05"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Since SoftMax is already applied inside the model, this architecture is meant to be used with a loss function that expects probabilities, such as ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"qf8ijH5NqT"},{"type":"inlineCode","value":"nn.NLLLoss","key":"pGXFTcS1Kf"},{"type":"text","value":" (combined with a log of the output) rather than ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"kkCGGtEDGt"},{"type":"inlineCode","value":"nn.CrossEntropyLoss","key":"e9za4GfZyI"},{"type":"text","value":". ","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"gKHrzwntwd"},{"type":"inlineCode","value":"nn.CrossEntropyLoss","key":"EdZvr1mcmj"},{"type":"text","value":" already applies SoftMax internally, so combining it with a model that also applies SoftMax would apply it twice, which can affect training. This becomes relevant once this architecture is actually trained in a later activity.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"rQ4zSQOsTW"}],"key":"JjpEoG5VG5"}],"key":"mkq7wb75km"}],"key":"OeiMWFokOq"}],"key":"zv0zQB9wMM"},"references":{"cite":{"order":[],"data":{}}}}